# ============================================================
# 环境变量模板：复制为 .env 后按环境填写（.env 不入库）
#   本地开发/内网穿透：DB/Redis 指向本机；imgbed 三项本机兼容参数按需开启
#   生产（webchat.bitlesu.com）：DB/Redis 指向服务器共享实例；imgbed 兼容参数留空
# ============================================================

APP_DEBUG=false

# ---- 数据库 ----
# 本地：127.0.0.1 / 本机 MySQL
# 生产：服务器共享 MariaDB（见记忆「生产部署」与「服务器基建」）
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_NAME=chats
DB_USER=root
DB_PASS=
DB_PORT=3306
DB_CHARSET=utf8mb4
DEFAULT_LANG=zh-cn

# 注：原 .env 的 SERVER_PORT（内网穿透地址）经全项目核查「零引用」，
# 前端与 WebSocket 均用相对路径 / 当前域名自动适配，故不再保留。

# ============================================================
# JWT v2 认证配置（生产务必替换 JWT_SECRET 为随机串，≥32 字符）
# ============================================================
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ISSUER=webchat.bitlesu.com
JWT_AUDIENCE=webchat.bitlesu.com
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL=7200
JWT_REFRESH_TOKEN_TTL=604800
JWT_REFRESH_TOKEN_REMEMBER_TTL=2592000
JWT_ENABLE_REFRESH_TOKEN=true
JWT_ENABLE_BLACKLIST=true
JWT_BLACKLIST_PREFIX=jwt:blacklist:
JWT_BLACKLIST_TTL=7200
JWT_BLACKLIST_CACHE=
JWT_INCLUDE_USER_DETAILS=true
JWT_FORCE_HTTPS=false
JWT_VERIFY_IP=false
JWT_VERIFY_USER_AGENT=false
JWT_MAX_REFRESH_TOKENS=5
JWT_DEBUG_ERRORS=false

# ============================================================
# Imgbed 自建图床（CloudFlare-ImgBed，见 app/service/ImgbedService.php 头注释）
# ============================================================
IMGBED_ENABLED=true
IMGBED_BASE=https://img.bitlesu.com
IMGBED_TOKEN=imgbed_xxxxxxxxxxxxxxxxxxxxxxxx
IMGBED_TIMEOUT=300
# 以下三项「仅本机开发」需要（phpstudy 老 OpenSSL / 本机代理），生产环境留空：
#IMGBED_PROXY=http://127.0.0.1:7890
#IMGBED_TLS=1.3
#IMGBED_CAINFO=D:\Git\mingw64\etc\ssl\certs\ca-bundle.crt

# ---- 上传优先级：imgbed=只用图床 / local=只用本地（均不自动降级，失败返回错误）----
UPLOAD_PRIORITY=imgbed
UPLOAD_PRIORITY_IMAGE=imgbed
UPLOAD_PRIORITY_VIDEO=imgbed
UPLOAD_PRIORITY_DOCUMENT=imgbed
UPLOAD_PRIORITY_FILE=imgbed
UPLOAD_PRIORITY_AVATAR=imgbed
